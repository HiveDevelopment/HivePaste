APP_NAME=HivePaste
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://paste.hivepanel.dev
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=debug

# SQLite is fine for development and small private deployments.
# For production, use compose.mariadb.yaml and set DB_CONNECTION=mysql.
DB_CONNECTION=sqlite
# DB_PASSWORD=replace-with-a-long-random-password
# DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# HivePaste host settings
HIVEPASTE_ANONYMOUS_ENABLED=true
HIVEPASTE_API_ENABLED=true
HIVEPASTE_MAX_PASTE_BYTES=524288
HIVEPASTE_WEB_RATE_LIMIT=10
HIVEPASTE_API_RATE_LIMIT=30
HIVEPASTE_DEFAULT_EXPIRATION=7d
HIVEPASTE_ALLOW_NEVER_EXPIRE=false

# Optional Cloudflare Turnstile: set BOTH keys to enable for anonymous web uploads and reports
HIVEPASTE_TURNSTILE_SITE_KEY=
HIVEPASTE_TURNSTILE_SECRET_KEY=

# Reject pastes containing common credential patterns (may flag legitimate examples)
HIVEPASTE_SECRET_DETECTION=true
HIVEPASTE_REPORT_RATE_LIMIT=3

HIVEPASTE_LEGAL_UPDATED="9th October 2026"